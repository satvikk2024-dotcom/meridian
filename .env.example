# =============================================================================
# Meridian — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# Never commit `.env` itself.
# =============================================================================

# ----- App config -----
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# ----- Database -----
# SQLite for MVP. Swap to a Postgres URL when deploying.
DATABASE_URL=sqlite:///./data/meridian.db

# ----- LLM Configuration -----
# `ollama` for local dev, `gemini` for free-tier hosted, `anthropic` for $5 free credits
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini (free tier; only set if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic ($5 free credits; only set if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----- Synthesizer override -----
# The synthesizer can use a different (better) model than the agents.
# Leave blank to use the default LLM_PROVIDER for synthesis too.
SYNTHESIZER_PROVIDER=
SYNTHESIZER_MODEL=

# ----- Caching -----
# Always cache during development. Set to `false` only for the final
# evaluation run when you want fresh data.
CACHE_LLM_CALLS=true
CACHE_SOURCE_FETCHES=true
CACHE_DIR=./data/cache

# ----- Data sources -----
# All of these are free or have free tiers.

# NewsAPI free tier — https://newsapi.org/ (100 requests/day)
NEWSAPI_KEY=

# Reddit — https://www.reddit.com/prefs/apps (free with auth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=meridian/0.1 (by /u/yourname)

# GitHub — public token, optional but raises rate limit (5000/hr)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# SEC EDGAR requires only a User-Agent. Set yours below.
# Format: "Your Name (your.email@example.com)"
SEC_USER_AGENT=
